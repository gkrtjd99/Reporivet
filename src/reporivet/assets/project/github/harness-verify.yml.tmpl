# reporivet:managed version={{HARNESS_VERSION}}
name: Harness Verify

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.event_name == 'pull_request' && format('refs/pull/{0}/head', github.event.pull_request.number) || github.sha }}
          fetch-depth: 0
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.11"
      - name: Bind explicit verification target
        shell: bash
        env:
          EVENT_NAME: ${{ github.event_name }}
          PR_BASE_SHA: ${{ github.event.pull_request.base.sha }}
          PR_HEAD_SHA: ${{ github.event.pull_request.head.sha }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
          PUSH_BASE_SHA: ${{ github.event.before }}
          PUSH_HEAD_SHA: ${{ github.sha }}
          PUSH_REF_NAME: ${{ github.ref_name }}
        run: |
          set -eu
          if [ "$EVENT_NAME" = "pull_request" ]; then
            base_sha=$PR_BASE_SHA
            head_sha=$PR_HEAD_SHA
            target="pull_request:$PR_NUMBER"
          else
            base_sha=$PUSH_BASE_SHA
            if [ "$base_sha" = "0000000000000000000000000000000000000000" ]; then
              base_sha=
            fi
            head_sha=$PUSH_HEAD_SHA
            target="push:$PUSH_REF_NAME"
          fi
          actual_head=$(git rev-parse HEAD)
          if [ "$actual_head" != "$head_sha" ]; then
            printf 'checked-out HEAD %s does not match explicit head %s\n' "$actual_head" "$head_sha" >&2
            exit 2
          fi
          {
            printf 'REPORIVET_BASE_SHA=%s\n' "$base_sha"
            printf 'REPORIVET_HEAD_SHA=%s\n' "$head_sha"
            printf 'REPORIVET_TARGET=%s\n' "$target"
          } >> "$GITHUB_ENV"
      - name: Bootstrap
        run: ./dev/bootstrap
      - name: Verify
        run: ./dev/verify
      - name: Append verification report
        if: always()
        shell: bash
        run: |
          report=
          for candidate in .harness/runs/*-verify/report.md; do
            if [ -f "$candidate" ]; then
              report=$candidate
            fi
          done
          if [ -n "$report" ]; then
            cat "$report" >> "$GITHUB_STEP_SUMMARY"
          else
            printf 'No Reporivet verification report was produced.\n' >> "$GITHUB_STEP_SUMMARY"
          fi
      - name: Upload verification evidence
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: reporivet-verification-runs
          path: .harness/runs/
          if-no-files-found: warn
