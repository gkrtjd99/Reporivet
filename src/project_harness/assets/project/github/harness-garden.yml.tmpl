# project-harness:managed version={{HARNESS_VERSION}}
name: Harness Garden

on:
  workflow_dispatch:
  schedule:
    - cron: "17 3 * * 1"

permissions:
  contents: read

jobs:
  garden:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-python@v6
        with:
          python-version: "3.11"
      - name: Report maintenance candidates
        run: |
          mkdir -p .harness
          ./dev/garden | tee .harness/garden-report.txt
      - uses: actions/upload-artifact@v7
        with:
          name: harness-garden-report
          path: .harness/garden-report.txt
